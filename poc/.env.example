# Windows (PowerShell):  Get-Content .env | % { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }
# Linux/macOS:           set -a; source .env; set +a
# Install:               pip install requests pillow
# Run:                   python poc.py            (all products)   |   python poc.py <product_folder>

BASE_URL=https://your-gateway/v1
API_KEY=sk-xxxx
PLANNER_MODEL=gpt-4o

# name|mode|size    mode: edits = POST /images/edits (multi-reference)   chat = image returned via /chat/completions
# size empty = let the model/gateway decide. Test 2-3 models; replace the names with what your gateway exposes.
IMAGE_MODELS=gpt-image-1|edits|1536x1024,your-model-b|chat|,your-model-c|edits|

TEXT_MODE=model
TARGET_SIZE=1464x600
COPY_LANG=English
N_MODULES=5
